<?xml version="1.0"?>
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <staticContent>
      <mimeMap fileExtension=".sib" mimeType="application/x-sibelius-score" />
    </staticContent>
  </system.webServer>
  <location path="SonateUndSinfonie">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-sonate-und-sinfonie-ein-altes-thema-auf-neuen-wegen" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="Bach">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-johann-sebastian-bach-ein-superstar-gestern-und-heute" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="Lamento">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-lamentobass-musik-aus-vier-jahrhunderten" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="beethoven5">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-ludwig-van-beethoven-die-fuenfte-sinfonie" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="kostenlosesoftware">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-kostenlose-software-fuer-den-musikunterricht" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="transponierendeinstrumente">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-orchesterinstrumente-transponierende-instrumente" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="harmonielehre">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-harmonielehre-reloaded-eine-praktische-anleitung-fuer-musikerinnen-und-musiker" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="harmonieundform">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-harmonielehre-harmonie-und-form-fuer-kompositionen-in-dur" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="IntervalleUndAkkorde">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-intervalle-und-akkorde" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="harmonielehresequenzenforkids">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-praktische-harmonielehre-sequenzen-fuer-kinder" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="bandimpulse1">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-band-impulse-heft-1-that-image" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="bandimpulse2">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-band-impulse-heft-2-elise-in-black" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="bandimpulse3">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-band-impulse-heft-3-pattern-und-styles-1" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="bandimpulse4">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-band-impulse-heft-4-gehoerbildung-und-musiklehre" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="kinderhauslied">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-das-kinderhauslied" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>  
  <location path="inventionen">
