    </system.webServer>
  </location> 
  <location path="filmmusik">
    <system.webServer>
      <httpRedirect enabled="true" destination="/oer-filmmusik" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
  <location path="openbooks">
    <system.webServer>
      <httpRedirect enabled="true" destination="/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location> 
</configuration>